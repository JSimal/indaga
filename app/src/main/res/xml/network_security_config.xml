<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ip-api.com solo ofrece HTTP en su plan gratuito; el resto de trafico va por HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
